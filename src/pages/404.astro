---
import Landing from '../layouts/Landing.astro';
---
<Landing title="Not found · Despacho Bonsai" description="That page doesn't exist." path="/404" noindex>
  <main style="padding:64px 0 80px;max-width:820px">
    <div class="code">Error 404</div>
    <h1 class="display grit" style="font-size:clamp(48px,9vw,120px);margin:14px 0 18px">Page not found.</h1>
    <p style="font:450 19px/1.5 var(--cond);color:var(--ink2);margin-bottom:28px">It doesn't exist, or it moved when the site was rebuilt.</p>
    <a class="cta" href="/">Back to the start <span aria-hidden="true">→</span></a>
  </main>
</Landing>
