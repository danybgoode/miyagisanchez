---
// Privacy, terms and cookies share one layout. Titles and intros carry over from the old pages; the body sections
// were rewritten for a services practice (the old ones described the retired SaaS).
import Base from '../layouts/Base.astro';
import { type Lang, SITE, useT } from '../i18n';

interface Props {
  lang: Lang;
  page: 'privacy' | 'terms' | 'cookies';
}
const { lang, page } = Astro.props;
const t = useT(lang, page);
const s = SITE[lang];
const body = s[`${page}_body`];
const contact = useT(lang, 'privacy');
---
<Base lang={lang} path={`/${page}`} title={t('page_title')} description={t('meta_description')} ogTitle={t('meta_og_title')}>
  <main class="container">
    <div class="card standard-panel">
      <div class="card-header">{t(`${page}_title`)}</div>
      <div class="card-text">
        <p><strong>{s.legal_updated}</strong></p>
        <p>{t(`${page}_intro`)}</p>
        {body.map((section, i) => (
          <>
            <h3 class="card-title" style="margin-top: 24px;">{i + 1}. {section.h}</h3>
            <p>{section.p}</p>
          </>
        ))}
        <h3 class="card-title" style="margin-top: 24px;">{body.length + 1}. {s.legal_contact_title}</h3>
        <p>{contact('privacy_email')}</p>
        <p>{contact('privacy_address')}</p>
      </div>
    </div>
  </main>
</Base>
